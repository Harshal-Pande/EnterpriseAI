# Enterprise AI Control Room — Frontend Environment Template
# Copy this file to frontend/.env.local or frontend/.env

# Base URL for the FastAPI backend API service
VITE_API_BASE_URL=http://localhost:8000

# SECURITY NOTE: All VITE_* environment variables are embedded into the client
# bundle at build time and are publicly observable in browser source code.
# NEVER put production administrator secrets or privileged API keys here.
# For local development only, you may specify a non-production key (e.g. dev-operator-key).
# In production, credentials should be entered by the user at runtime or managed via secure cookies/reverse proxy.
VITE_API_KEY=
