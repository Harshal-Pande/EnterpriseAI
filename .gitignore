# ============================================================
# Root .gitignore for Enterprise AI Mesh
# ============================================================

# ----------------------------------------------------------
# Environment / Secrets
# ----------------------------------------------------------
.env
.env.local
.env.*.local
.neon
# Allow the template
!.env.example

# ----------------------------------------------------------
# Python bytecode and caches
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ----------------------------------------------------------
# Python virtual environments
# ----------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ----------------------------------------------------------
# Python test / coverage output
# ----------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
test-results/

# ----------------------------------------------------------
# Python packaging / distribution
# ----------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ----------------------------------------------------------
# Python type checkers / linters
# ----------------------------------------------------------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ----------------------------------------------------------
# Frontend — Node / npm
# ----------------------------------------------------------
# node_modules is already covered by frontend/.gitignore;
# add the root-level pattern in case a root package.json
# is ever introduced.
node_modules/

# frontend/dist is produced by `npm run build`; covered by
# frontend/.gitignore, but list it here for clarity.
frontend/dist/
frontend/dist-ssr/

# ----------------------------------------------------------
# Logs and temporary files
# ----------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo

# ----------------------------------------------------------
# OS / editor metadata
# ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# JetBrains IDEs
.idea/

# VS Code (allow shared recommended-extensions file)
.vscode/*
!.vscode/extensions.json

# ----------------------------------------------------------
# Miscellaneous local artifacts
# ----------------------------------------------------------
*.local

# Generated validation reports (regenerate with documented commands)
backend/data/validation_report.json
backend/data/workbook_validation_report.json
