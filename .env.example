# Enterprise AI Mesh — Environment Configuration Template
# Copy this file to .env before starting the stack via Docker Compose.
# Never commit the actual .env file or real secrets to version control.

# PostgreSQL Database Configuration (Required for Docker Compose)
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=enterprise_ai

# Application Environment Mode ('production' or 'development')
# In 'production' mode, the API fails closed if credentials are not configured.
APP_ENVIRONMENT=production

# Server-Side API Keys for Role-Based Access Control (Required in Production)
ADMIN_API_KEY=replace_with_strong_admin_api_key
FINANCE_API_KEY=replace_with_strong_finance_api_key
SUPPLY_CHAIN_API_KEY=replace_with_strong_supply_chain_api_key
OPERATOR_API_KEY=replace_with_strong_operator_api_key
VIEWER_API_KEY=replace_with_strong_viewer_api_key

# Scenario Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_OPEN_SCENARIOS=10
SCHEDULER_LEASE_SECONDS=60
WORKFLOW_STALE_TIMEOUT_SECONDS=300

# Blockchain Simulation Flag
# Set to true for safe local cryptographic audit anchoring without external gas costs.
SIMULATE_BLOCKCHAIN=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
