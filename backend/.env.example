# Enterprise AI Mesh — environment variable template
# Copy this file to .env and fill in real values.
# Never commit the .env file.

# PostgreSQL connection (Phase 2)
DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_db

# Neo4j connection (Phase 8)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Blockchain / EVM network (Phase 7)
# The target test network has not been selected yet.
# Set this to a supported testnet RPC URL once Phase 7 begins.
# DO NOT use the Polygon Mumbai endpoint — that network was sunset in April 2024.
# Example placeholder only (not a working URL):
#   EVM_RPC_URL=https://rpc.<chosen-testnet>.example/
EVM_RPC_URL=

# Deployer private key for contract interactions (Phase 7)
# Keep this secret. Use a dedicated test wallet with no real funds.
PRIVATE_KEY=
