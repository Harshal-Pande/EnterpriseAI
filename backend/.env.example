# Enterprise AI Supply Chain Control Room — Backend Environment Template
# Copy this file to backend/.env and replace placeholders with real configuration.
# NEVER commit the actual .env file or real secrets to git.

# ── Database Configuration ──────────────────────────────────────────────────
# Primary application PostgreSQL database connection
DATABASE_URL=postgresql://eas_user:eas_dev_pass@localhost:5432/eas_dev

# Dedicated disposable test database (must contain "test" in database name)
TEST_DATABASE_URL=postgresql://eas_user:eas_dev_pass@localhost:5432/eas_test

# ── Application Environment & Security ──────────────────────────────────────
# Options: development, production, test
APP_ENVIRONMENT=development

# Role-based API keys for server-side authorization (X-API-Key: <token>)
# In production, at least one key must be configured, or the application fails closed.
# In development, built-in tokens (dev-admin-key, dev-finance-key, dev-supply-key, dev-operator-key, dev-viewer-key)
# are active for local testing; unauthenticated requests receive read-only VIEWER role.
ADMIN_API_KEY=
FINANCE_API_KEY=
SUPPLY_CHAIN_API_KEY=
OPERATOR_API_KEY=
VIEWER_API_KEY=
API_KEY=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Scenario Scheduler Configuration ────────────────────────────────────────
# Enable background scenario generation loop (defaults to false in pytest)
SCHEDULER_ENABLED=true

# Execution interval between autonomous scenario evaluation cycles (seconds)
SCHEDULER_INTERVAL_SECONDS=300

# Distributed lease timeout duration (seconds)
SCHEDULER_LEASE_SECONDS=60

# ── Blockchain Audit Anchoring (Task 12 & Task 18) ───────────────────────────
# If set to true, forces local simulation adapter without connecting to remote RPC
SIMULATE_BLOCKCHAIN=true

# Target EVM RPC endpoint (Sepolia, Polygon, or dedicated enterprise network)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# EVM Chain ID (e.g., 11155111 for Sepolia, 137 for Polygon)
BLOCKCHAIN_CHAIN_ID=11155111

# Deployed audit anchor smart contract address (0x...)
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Dedicated wallet private key for signing transactions (never use real funds)
BLOCKCHAIN_PRIVATE_KEY=
